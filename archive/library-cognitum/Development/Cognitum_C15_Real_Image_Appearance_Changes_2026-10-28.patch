+"""C15 real MOT17 pixel appearance ID-only benchmark; offline, no host authority.
+
+Predeclared: P2K's 3 sequences, original MPNTrack boxes, original and
+position/velocity comparison arms, P2L v1 grayscale 128D descriptor, P2L
+default appearance settings, unchanged native TrackEval MOT17 preprocessing.
+This is not a learned person-ReID benchmark or an independent detector.
+"""
+from __future__ import annotations
+import argparse
+from dataclasses import asdict
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import time
+from cognitum import spatial_p2k_challenge_gate as p2k
+from cognitum import spatial_p2k_dense_identity as dense
+from cognitum import spatial_p2l_appearance as app
+from cognitum import spatial_mot17_realdata_gate as rd
+from cognitum.spatial_trackeval_bridge import read_summary
+
+SEQUENCES=p2k.SEQUENCES
+ARMS=p2k.TRACKERS+('CognitumRealAppearancePosition','CognitumRealAppearanceVelocity')
+OUTPUT_BY_MODE=dict(position=ARMS[-2],velocity=ARMS[-1])
+
+
+def digest(path:Path)->str:
+    h=hashlib.sha256()
+    with path.open('rb') as fp:
+        for chunk in iter(lambda:fp.read(1024*1024),b''):h.update(chunk)
+    return h.hexdigest()
+
+
+def make_candidate(*, seq:str, mode:str, stage:Path, train:Path,
+                   params:dense.Params=dense.Params(), config:app.AppearanceConfig=app.AppearanceConfig()):
+    rawpath=stage/'trackers'/'MOT17-train'/'MPNTrackOriginal'/'data'/f'{seq}.txt'
+    cpath=train/seq/'seqinfo.ini'
+    import configparser
+    cfg=configparser.ConfigParser();cfg.read(cpath)
+    number=int(cfg['Sequence']['seqLength'])
+    obs,rows=dense.parse_id_blind(rawpath.read_bytes(),num_frames=number,max_boxes=params.max_boxes)
+    images={}
+    frame_hashes={}
+    for f in sorted(obs):
+        path=train/seq/'img1'/f'{f:06d}.jpg'
+        if path.is_symlink() or not path.is_file() or not 0<path.stat().st_size<=app.MAX_FRAME_BYTES:
+            raise RuntimeError('MISSING_OR_UNSAFE_IMAGE:'+str(path))
+        payload=path.read_bytes();images[f]=payload
+        frame_hashes[f'{f:06d}.jpg']=hashlib.sha256(payload).hexdigest()
+    start=time.monotonic()
+    descriptor=app.descriptors_from_frames(obs,images,sequence=seq)
+    featurization_seconds=time.monotonic()-start
+    # Every descriptor is typed, bound to original image bytes, frame, and box.
+    start=time.monotonic()
+    labels,counts=app.assign_with_appearance(obs,num_frames=number,
+                sequence=seq,image_bytes=images,descriptors=descriptor,
+                mode=mode,params=params,config=config)
+    association_seconds=time.monotonic()-start
+    emitted=[]
+    for frame in range(1,number+1):
+        original=rows.get(frame,[])
+        new_ids=labels.get(frame,[])
+        if len(new_ids)!=len(original):raise RuntimeError('DROPPED_OR_ADDED_DETECTIONS')
+        for source,tid in zip(original,new_ids):
+            if not 0<tid<=1000000:raise RuntimeError('INVALID_LABEL')
+            altered=source.copy();altered[1]=str(tid)
+            assert altered[0]==source[0] and altered[2:]==source[2:]
+            emitted.append(','.join(altered))
+    if sum(len(v) for v in rows.values())!=len(emitted):
+        raise RuntimeError('ROW_COUNT_MISMATCH')
+    path=stage/'trackers'/'MOT17-train'/OUTPUT_BY_MODE[mode]/'data'/f'{seq}.txt'
+    path.parent.mkdir(parents=True,exist_ok=True)
+    if path.exists():raise RuntimeError('CANDIDATE_ALREADY_EXISTS')
+    path.write_bytes(('\n'.join(emitted)+'\n').encode('utf8'))
+    # Verify all source prediction fields other than identity are retained.
+    compare=path.read_text().splitlines()
+    before=rawpath.read_text().splitlines()
+    if len(compare)!=len(before) or any(a.split(',')[0]!=b.split(',')[0] or
+          a.split(',')[2:]!=b.split(',')[2:] for a,b in zip(compare,before)):
+        raise RuntimeError('BOX_PROVENANCE_CHANGED')
+    return {'source_prediction_sha256':digest(rawpath),'output_sha256':digest(path),
+       'image_sha256':frame_hashes,'image_count':len(images),
+       'descriptor_count':len(descriptor),'source_bbox_count':len(emitted),
+       'frozen_params':asdict(params),'frozen_appearance_config':asdict(config),
+       'feature_seconds':round(featurization_seconds,3),
+       'association_seconds':round(association_seconds,3),'counts':counts,
+       'research_only':True,'uses_original_or_gt_identity_for_assignment':False}
+
+
+def evaluate(*, stage:Path, evidence:dict, trackeval:Path, source_zip:Path):
+    pin=rd.verify_pinned_trackeval_source(source_zip=source_zip,checkout=trackeval)
+    summaries=[stage/'trackers'/'MOT17-train'/a/'pedestrian_summary.txt' for a in ARMS]
+    if any(x.exists() for x in summaries):raise RuntimeError('STALE_METRICS')
+    script=trackeval/'scripts'/'run_mot_challenge.py'
+    shim=Path(__file__).parent/'c15_trackeval_legacy_numpy_compat.py'
+    command=[sys.executable,str(shim),str(script),
+       '--GT_FOLDER',str(stage/'gt'),'--TRACKERS_FOLDER',str(stage/'trackers'),
+       '--BENCHMARK','MOT17','--SPLIT_TO_EVAL','train','--TRACKERS_TO_EVAL',*ARMS,
+       '--CLASSES_TO_EVAL','pedestrian','--METRICS','HOTA','CLEAR','Identity',
+       '--DO_PREPROC','True','--PLOT_CURVES','False',
+       '--PRINT_CONFIG','False','--TIME_PROGRESS','False','--USE_PARALLEL','False']
+    ran=subprocess.run(command,cwd=trackeval,capture_output=True,text=True,timeout=400,check=False)
+    if ran.returncode:raise RuntimeError('OFFICIAL_EVALUATION_FAILED:'+ran.stdout[-3000:]+ran.stderr[-1500:])
+    if rd.verify_pinned_trackeval_source(source_zip=source_zip,checkout=trackeval)!=pin:
+        raise RuntimeError('EVALUATOR_SOURCE_CHANGED')
+    for key,sha in evidence['stage_sha256'].items():
+        if digest(stage/key)!=sha:raise RuntimeError('INPUTS_CHANGED_DURING_EVAL:'+key)
+    scores={a:read_summary(p) for a,p in zip(ARMS,summaries)}
+    return {'status':'completed_official','source_pin':pin,'metrics':scores,
+      'summary_sha256':{a:digest(p) for a,p in zip(ARMS,summaries)},
+      'stdout_tail':ran.stdout[-1900:],'do_preproc':True}
+
+
+def main():
+    parser=argparse.ArgumentParser()
+    parser.add_argument('--stage',type=Path,required=True)
+    parser.add_argument('--train',type=Path,required=True)
+    parser.add_argument('--labels-zip',type=Path,required=True)
+    parser.add_argument('--data-zip',type=Path,required=True)
+    parser.add_argument('--trackeval',type=Path,required=True)
+    parser.add_argument('--trackeval-zip',type=Path,required=True)
+    parser.add_argument('--evidence',type=Path,required=True)
+    a=parser.parse_args()
+    start=time.monotonic()
+    baseline=p2k.stage(data_zip=a.data_zip,labels_zip=a.labels_zip,out_dir=a.stage)
+    evidence={'milestone':'C15_REAL_IMAGE_APPEARANCE_R1','research_only':True,
+       'matched_original_tracker_boxes':True,
+       'model':'C15 P2L original grayscale 4x4 x 8-bin histogram (not ReID)',
+       'appearance_version':app.ENCODER_ID,
+       'appearance_digest':app.ENCODER_DIGEST.hex(),
+       'configuration_frozen_before_evaluation':True,
+       'gt_ids_exposed_to_associator':False,'mpntrack_ids_exposed_to_associator':False,
+       'sequences':{},'baseline':baseline,'external_eval':None}
+    # Stage both new arms; extract appearance features per mode separately,
+    # since the public P2L API revalidates full source bindings each invocation.
+    for seq in SEQUENCES:
+        evidence['sequences'][seq]={}
+        for mode in ('position','velocity'):
+            print('RUN',seq,mode,flush=True)
+            evidence['sequences'][seq][mode]=make_candidate(seq=seq,mode=mode,stage=a.stage,train=a.train)
+            print('DONE',seq,mode,'features',evidence['sequences'][seq][mode]['descriptor_count'],flush=True)
+    evidence['stage_sha256']=dict(baseline['staged_sha256'])
+    for seq in SEQUENCES:
+        for mode in ('position','velocity'):
+            key=f'trackers/MOT17-train/{OUTPUT_BY_MODE[mode]}/data/{seq}.txt'
+            evidence['stage_sha256'][key]=digest(a.stage/key)
+    print('OFFICIAL_EVAL',flush=True)
+    evidence['external_eval']=evaluate(stage=a.stage,evidence=evidence,trackeval=a.trackeval,source_zip=a.trackeval_zip)
+    evidence['wall_seconds']=round(time.monotonic()-start,3)
+    a.evidence.write_text(json.dumps(evidence,indent=2,sort_keys=True)+'\n')
+    for name,v in evidence['external_eval']['metrics'].items():
+        print('RESULT',name,{key:v[key] for key in ('HOTA','DetA','AssA','MOTA','IDF1','IDSW')},flush=True)
+    print('EVIDENCE',str(a.evidence),flush=True)
+
+if __name__=='__main__': main()