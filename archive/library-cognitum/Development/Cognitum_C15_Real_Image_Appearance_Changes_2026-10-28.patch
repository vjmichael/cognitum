+"""Offline C15 P2M real-data benchmark integrity guards (does not ship MOT17 images)."""
+from __future__ import annotations
+import hashlib
+from pathlib import Path
+import tempfile
+import unittest
+from PIL import Image
+from cognitum.spatial_p2k_dense_identity import Detection
+from cognitum import spatial_p2l_appearance as app
+from tools.run_c15_mot17_real_appearance import ARMS, OUTPUT_BY_MODE, SEQUENCES
+
+
+class RealAppearanceBenchTests(unittest.TestCase):
+    def test_predeclared_arms_and_seqs_immutable(self):
+        self.assertEqual(SEQUENCES,('MOT17-02-DPM','MOT17-05-DPM','MOT17-13-DPM'))
+        self.assertEqual(ARMS,('MPNTrackOriginal','CognitumP2KPosition','CognitumP2KVelocity',
+              'CognitumRealAppearancePosition','CognitumRealAppearanceVelocity'))
+        self.assertEqual(OUTPUT_BY_MODE['velocity'],ARMS[-1])
+    def test_frame_batch_descriptor_matches_individual_encoding_byte_for_byte(self):
+        import io
+        im=Image.new('RGB',(144,128),(70,150,210))
+        for x in range(24,60):
+            for y in range(20,98):im.putpixel((x,y),(x*2,y*2,255-x))
+        out=io.BytesIO();im.save(out,format='JPEG',quality=92)
+        jpeg=out.getvalue()
+        frames={5:[Detection(5,10,15,60,90),Detection(5,23,19,35,70)],6:[]}
+        specs=app.descriptors_from_frames(frames,{5:jpeg},sequence='CANONICAL-IMAGE-ONLY')
+        self.assertEqual(len(specs),2)
+        for i,d in enumerate(frames[5]):
+            direct=app.descriptor_from_frame(image_bytes=jpeg,detection=d,index=i,
+                  sequence='CANONICAL-IMAGE-ONLY')
+            self.assertEqual(specs[5,i].SerializeToString(deterministic=True),
+                             direct.SerializeToString(deterministic=True))
+            self.assertEqual(specs[5,i].frame_sha256,hashlib.sha256(jpeg).digest())
+            self.assertFalse(specs[5,i].grants_authority)
+    def test_wrong_source_image_binding_refused(self):
+        import io
+        im=Image.new('L',(24,24),80)
+        out=io.BytesIO();im.save(out,format='PNG');jpeg=out.getvalue()
+        frames={1:[Detection(1,0,0,20,20)]}
+        specs=app.descriptors_from_frames(frames,{1:jpeg},sequence='S')
+        bad={1:jpeg+b'changed'}
+        with self.assertRaisesRegex(app.P2LRejected,'DESCRIPTOR_BINDING_MISMATCH'):
+            app.assign_with_appearance(frames,num_frames=1,sequence='S',image_bytes=bad,descriptors=specs)
+    def test_batch_rejects_missing_and_extra_images(self):
+        import io
+        im=Image.new('L',(24,24),80);out=io.BytesIO();im.save(out,format='PNG')
+        frames={1:[Detection(1,0,0,20,20)],2:[]}
+        with self.assertRaisesRegex(app.P2LRejected,'IMAGE_FRAME_SET_MISMATCH'):
+            app.descriptors_from_frames(frames,{1:out.getvalue(),2:out.getvalue()},sequence='S')
+
+if __name__=='__main__':unittest.main()
