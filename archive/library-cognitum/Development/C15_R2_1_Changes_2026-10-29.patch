 def _cos(a,b):return float(max(0,min(2,1-np.dot(a,b))))
+
+
+def _coherent_gallery_distance(gray, color, template_gray, template_color,
+                               gallery, config):
+    """Find one jointly compatible historical snapshot, never mix two snapshots.
+
+    A match must satisfy each available modality's individual gate before
+    ranking by the weighted distance. Returns None for unsupported matches.
+    """
+    pairs=[(_cos(gray,template_gray),
+            _cos(color,template_color) if color is not None and template_color is not None else 0)]
+    for oldg,oldc in gallery:
+        if color is not None and oldc is None:continue
+        pairs.append((_cos(gray,oldg), _cos(color,oldc) if color is not None else 0))
+    valid=[(g,c) for g,c in pairs if g<=config.max_appearance_distance and
+           (color is None or c<=config.max_color_distance)]
+    if not valid:return None
+    return min(valid,key=lambda pair:(1-config.color_weight)*pair[0]
+        +config.color_weight*pair[1] if color is not None else pair[0])
 
 
