+"""R2 offline hypothesis tests: adversarial, matching, provenance, switchability."""
+from dataclasses import replace
+import io
+import unittest
+from PIL import Image, ImageDraw
+import numpy as np
+from cognitum.spatial_p2k_dense_identity import Detection
+from cognitum import spatial_p2l_appearance as p2l
+from cognitum import spatial_appearance_r2 as r2
+
+
+def fixture(*,same_color=False, missing=()):
+    frames={};images={}
+    for f in (1,2,3,4,5):
+        if f in missing:continue
+        # two moving boxes that cross; source identity never enters detections
+        boxes=[(8+f*5,12,13,25),(58-f*5,12,13,25)]
+        im=Image.new('RGB',(96,64),(15,15,15));dr=ImageDraw.Draw(im)
+        colors=('red','red' if same_color else 'blue')
+        for (x,y,w,h),c in zip(boxes,colors):dr.rectangle((x,y,x+w-1,y+h-1),fill=c)
+        ds=[Detection(f,*x) for x in boxes]
+        frames[f]=ds
+        o=io.BytesIO();im.save(o,format='PNG');images[f]=o.getvalue()
+    g=p2l.descriptors_from_frames(frames,images,sequence='fixture')
+    c=r2.color_descriptors(frames,images,sequence='fixture')
+    return frames,images,g,c
+
+class R2Tests(unittest.TestCase):
+    def test_r2_color_is_normalized_and_id_blind(self):
+        frames,images,g,c=fixture()
+        self.assertEqual(len(c),10)
+        self.assertNotEqual(list(c[1,0].vector),list(c[1,1].vector))
+        self.assertEqual(c[1,0].image_source_id,'fixture')
+        result,stats,audit=r2.associate_r2(frames,num_frames=5,sequence='fixture',image_bytes=images,gray_descriptors=g,color_descriptors_map=c)
+        self.assertEqual(sum(map(len,result.values())),10)
+        self.assertTrue(stats['research_only_no_authority'])
+        self.assertTrue(all(len(set(row))==len(row) for row in result.values()))
+    def test_all_switches_individually_off(self):
+        frames,images,g,c=fixture()
+        switches=('adaptive_appearance','guarded_updates','color_features','kalman_motion',
+                  'long_gap_gallery','ambiguous_abstention','size_geometry')
+        for name in switches:
+            with self.subTest(name=name):
+                conf=replace(r2.R2Config(),**{name:False})
+                labels,stats,_=r2.associate_r2(frames,num_frames=5,sequence='fixture',image_bytes=images,
+                           gray_descriptors=g,color_descriptors_map=c if conf.color_features else None,config=conf)
+                self.assertEqual(stats['input_boxes'],10)
+                self.assertEqual(len(labels),5)
+    def test_tampered_frame_binding_fails_closed(self):
+        frames,images,g,c=fixture()
+        spec=c[1,0];original=spec.frame_sha256
+        spec.frame_sha256=b'X'*32
+        with self.assertRaisesRegex(r2.R2Rejected,'PROVENANCE_MISMATCH'):
+            r2.associate_r2(frames,num_frames=5,sequence='fixture',image_bytes=images,gray_descriptors=g,color_descriptors_map=c)
+        spec.frame_sha256=original
+    def test_tampered_model_id_rejected(self):
+        frames,images,g,c=fixture()
+        c[1,0].model_id='untrusted-v1'
+        with self.assertRaisesRegex(r2.R2Rejected,'PROVENANCE_MISMATCH'):
+            r2.associate_r2(frames,num_frames=5,sequence='fixture',image_bytes=images,gray_descriptors=g,color_descriptors_map=c)
+    def test_identical_people_flag_uncertainty(self):
+        frames,images,g,c=fixture(same_color=True)
+        _,stats,audit=r2.associate_r2(frames,num_frames=5,sequence='fixture',image_bytes=images,gray_descriptors=g,color_descriptors_map=c,
+                                      config=replace(r2.R2Config(),match_margin=10))
+        self.assertGreater(stats.get('abstained_identity_proposals',0),0)
+        self.assertTrue(any(x['not_authorized'] for x in audit))
+    def test_ambiguous_abstention_is_switchable(self):
+        frames,images,g,c=fixture(same_color=True)
+        _,stats,_=r2.associate_r2(frames,num_frames=5,sequence='fixture',image_bytes=images,gray_descriptors=g,color_descriptors_map=c,
+                                  config=replace(r2.R2Config(),match_margin=10,ambiguous_abstention=False))
+        self.assertEqual(stats.get('abstained_identity_proposals',0),0)
+        self.assertGreater(stats['ambiguous_matches'],0)
+        self.assertGreater(stats['template_updates_blocked'],0)
+    def test_gap_and_bounded_gallery(self):
+        frames,images,g,c=fixture(missing=(3,4))
+        labels,stats,_=r2.associate_r2(frames,num_frames=5,sequence='fixture',image_bytes=images,gray_descriptors=g,color_descriptors_map=c)
+        self.assertEqual(stats['frames_without_detections'],2)
+        self.assertEqual(stats['input_boxes'],6)
+    def test_configuration_fail_closed(self):
+        for conf in (replace(r2.R2Config(),gallery_limit=1000),replace(r2.R2Config(),color_weight=float('nan')),
+                     replace(r2.R2Config(),kalman_motion=1),replace(r2.R2Config(),max_reentry_gap=-1)):
+            with self.assertRaises(r2.R2Rejected):r2.check_config(conf)
+    def test_provenance_required_for_color(self):
+        frames,images,g,c=fixture()
+        with self.assertRaisesRegex(r2.R2Rejected,'COLOR_EVIDENCE_MISSING'):
+            r2.associate_r2(frames,num_frames=5,sequence='fixture',image_bytes=images,gray_descriptors=g)
+
+if __name__=='__main__':unittest.main()
+
+def test_long_gap_gallery_reentry_without_leaked_identity():
+    frames,images,g,c=fixture(missing=(2,3,4))
+    # Remap final observation from frame 5 to frame 20 with matching image bytes;
+    # re-compute descriptors after remapping, never using GT or source track IDs.
+    d=frames.pop(5)[0]
+    frames.pop(1)  # one object, well separated in time
+    source=images.pop(5)
+    images.pop(1)
+    frames={f:[Detection(f,10,10,15,28)] for f in (1,2,3,20)}
+    im=Image.new('RGB',(100,65),'black')
+    ImageDraw.Draw(im).rectangle((10,10,24,37),fill='red')
+    fp=io.BytesIO();im.save(fp,format='PNG')
+    images={f:fp.getvalue() for f in frames}
+    g=p2l.descriptors_from_frames(frames,images,sequence='fixture')
+    c=r2.color_descriptors(frames,images,sequence='fixture')
+    recovered,stats,_=r2.associate_r2(frames,num_frames=20,sequence='fixture',image_bytes=images,
+                                      gray_descriptors=g,color_descriptors_map=c)
+    assert recovered[3]==recovered[20],(recovered,stats)
+    assert stats['gallery_reentries']==1
+    no_reentry,_,_=r2.associate_r2(frames,num_frames=20,sequence='fixture',image_bytes=images,
+                  gray_descriptors=g,color_descriptors_map=c,
+                  config=replace(r2.R2Config(),long_gap_gallery=False))
+    assert no_reentry[3]!=no_reentry[20]
+
+
+def test_kalman_predict_and_joseph_update_are_bounded():
+    d=Detection(1,10,10,10,20)
+    initial=r2._init_state(1,1,d,r2._unit([1]*128),None,r2.R2Config())
+    predicted,P=r2._predict(initial,3,r2.R2Config())
+    assert float(P[0,0])>float(initial.P[0,0])
+    r2._correction(initial,predicted,P,50,25,r2.R2Config())
+    assert np.all(np.linalg.eigvalsh(initial.P)>=-1e-8)
+    assert np.isfinite(initial.x).all()
+
+def test_protobuf_r2_report_is_research_only_and_versioned():
+    from cognitum.proto import spatial_appearance_r2_pb2 as pb
+    frames,images,g,c=fixture(same_color=True)
+    config=replace(r2.R2Config(),match_margin=8)
+    labels,stats,audit=r2.associate_r2(frames,num_frames=5,sequence='fixture',image_bytes=images,
+        gray_descriptors=g,color_descriptors_map=c,config=config)
+    report=r2.to_protobuf_report(labels=labels,stats=stats,audit=audit,sequence='fixture',config=config)
+    serialized=report.SerializeToString(deterministic=True)
+    restored=pb.R2ResearchReport.FromString(serialized)
+    assert restored.schema_version==1 and restored.research_only and not restored.grants_authority
+    assert len(restored.configuration_sha256)==32
+    assert len(restored.hypotheses)==10
+    assert sum(bool(h.ambiguous) for h in restored.hypotheses)==len(audit)
