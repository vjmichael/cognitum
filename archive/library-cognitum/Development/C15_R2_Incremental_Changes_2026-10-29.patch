+"""R2 benchmark-only forced-label ablation. No host identity authority."""
+import argparse,configparser,hashlib,json,subprocess,sys,time
+from dataclasses import asdict,replace
+from pathlib import Path
+from cognitum import spatial_p2k_dense_identity as dense
+from cognitum import spatial_p2l_appearance as old
+from cognitum import spatial_appearance_r2 as r2
+from cognitum import spatial_p2k_challenge_gate as challenge
+from cognitum import spatial_mot17_realdata_gate as rd
+from cognitum.spatial_trackeval_bridge import read_summary
+
+ARMS=('CognitumR2ForcedColor','CognitumR2ForcedGray')
+def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
+def main():
+    a=argparse.ArgumentParser()
+    for k in ('stage','train','source','source-zip'):a.add_argument('--'+k,type=Path,required=True)
+    x=a.parse_args();results={'scope':'C15_R2_EXPLORATORY_FORCED_HYPOTHESES_ONLY',
+      'research_only':True,'identity_assignments_authorized':False,
+      'same_original_boxes_and_gt':True,'mode':'ambiguous forced top1; updates frozen for ambiguous matches',
+      'configs':{},'sequences':{},'metrics':{}}
+    for name in ARMS:
+        config=replace(r2.R2Config(),ambiguous_abstention=False,color_features=(name==ARMS[0]))
+        results['configs'][name]=asdict(config)
+    for seq in challenge.SEQUENCES:
+        cfg=configparser.ConfigParser();cfg.read(x.train/seq/'seqinfo.ini')
+        nframes=int(cfg['Sequence']['seqLength'])
+        original=x.stage/f'trackers/MOT17-train/MPNTrackOriginal/data/{seq}.txt'
+        frames,source_rows=dense.parse_id_blind(original.read_bytes(),num_frames=nframes)
+        images={f:(x.train/seq/'img1'/f'{f:06d}.jpg').read_bytes() for f in sorted(frames)}
+        gray=old.descriptors_from_frames(frames,images,sequence=seq)
+        color=r2.color_descriptors(frames,images,sequence=seq)
+        results['sequences'][seq]={}
+        for name in ARMS:
+            conf=replace(r2.R2Config(),ambiguous_abstention=False,color_features=(name==ARMS[0]))
+            print('RUN',seq,name,flush=True);t=time.monotonic()
+            ids,counts,audit=r2.associate_r2(frames,num_frames=nframes,sequence=seq,
+                image_bytes=images,gray_descriptors=gray,
+                color_descriptors_map=color if conf.color_features else None,config=conf)
+            dest=x.stage/f'trackers/MOT17-train/{name}/data/{seq}.txt'
+            dest.parent.mkdir(parents=True,exist_ok=True)
+            if dest.exists():raise RuntimeError('OUTPUT_ALREADY_EXISTS')
+            lines=[]
+            for f in range(1,nframes+1):
+                for row,tid in zip(source_rows.get(f,[]),ids.get(f,[]),strict=True):
+                    changed=row.copy();changed[1]=str(tid);lines.append(','.join(changed))
+            dest.write_text('\n'.join(lines)+'\n')
+            before=original.read_text().splitlines();after=dest.read_text().splitlines()
+            assert len(before)==len(after) and all(a.split(',')[0]==b.split(',')[0]
+                 and a.split(',')[2:]==b.split(',')[2:] for a,b in zip(before,after))
+            results['sequences'][seq][name]={'counts':counts,'audit_count':len(audit),
+                'elapsed_seconds':round(time.monotonic()-t,3), 'prediction_sha256':sha(dest)}
+            print('DONE',seq,name,counts.get('forced_ambiguous_research_matches',0),flush=True)
+    pin=rd.verify_pinned_trackeval_source(source_zip=x.source_zip,checkout=x.source)
+    shim=Path(__file__).parent/'c15_trackeval_legacy_numpy_compat.py'
+    cmd=[sys.executable,str(shim),str(x.source/'scripts/run_mot_challenge.py'),
+       '--GT_FOLDER',str(x.stage/'gt'),'--TRACKERS_FOLDER',str(x.stage/'trackers'),
+       '--BENCHMARK','MOT17','--SPLIT_TO_EVAL','train','--TRACKERS_TO_EVAL',*ARMS,
+       '--CLASSES_TO_EVAL','pedestrian','--METRICS','HOTA','CLEAR','Identity',
+       '--DO_PREPROC','True','--PLOT_CURVES','False','--PRINT_CONFIG','False',
+       '--TIME_PROGRESS','False','--USE_PARALLEL','False']
+    proc=subprocess.run(cmd,cwd=x.source,capture_output=True,text=True,timeout=600)
+    if proc.returncode:raise RuntimeError(proc.stdout[-3000:]+proc.stderr[-1000:])
+    assert rd.verify_pinned_trackeval_source(source_zip=x.source_zip,checkout=x.source)==pin
+    for name in ARMS:
+        for seq in challenge.SEQUENCES:
+            dest=x.stage/f'trackers/MOT17-train/{name}/data/{seq}.txt'
+            assert sha(dest)==results['sequences'][seq][name]['prediction_sha256']
+        results['metrics'][name]=read_summary(x.stage/f'trackers/MOT17-train/{name}/pedestrian_summary.txt')
+        print('RESULT',name,{k:results['metrics'][name][k] for k in ('HOTA','MOTA','IDF1','IDSW')},flush=True)
+    results['source_pin']=pin
+    (x.stage/'r2_forced_ablation_evidence.json').write_text(json.dumps(results,sort_keys=True,indent=2)+'\n')
+if __name__=='__main__':main()
