+syntax = "proto3";
+package cognitum.spatial.v1;
+// C15 R2 offline evidence only; never host identity or permission authority.
+message R2AssociationHypothesis {
+  uint64 frame = 1;
+  uint32 observation_ordinal = 2;
+  uint64 proposed_track_id = 3;
+  repeated uint64 alternative_track_ids = 4;
+  bool ambiguous = 5;
+  bool tentative = 6;
+}
+message R2ResearchReport {
+  uint32 schema_version = 1;
+  string conversation_id = 2;
+  string sequence_id = 3;
+  string model_id = 4;
+  bytes configuration_sha256 = 5;
+  bool research_only = 6;
+  bool grants_authority = 7;
+  repeated R2AssociationHypothesis hypotheses = 8;
+  uint64 abstained_identity_proposals = 9;
+  uint64 template_updates_blocked = 10;
+  uint64 gallery_reentries = 11;
+}
