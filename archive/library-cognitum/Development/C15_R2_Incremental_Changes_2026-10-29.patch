+"""C15 Appearance Association R2: optional, offline ID-blind research associator.
+
+Seven independently switchable changes: appearance reliability, guarded feature
+updates, color descriptor, Kalman CV motion, gallery re-entry, ambiguity abstention,
+plus size-aware geometry. No source track IDs/GT or host authority can enter.
+
+Its returned track labels are *benchmark hypotheses*, never authenticated identity.
+"""
+from __future__ import annotations
+from collections import Counter, deque
+from dataclasses import dataclass, field
+from typing import Mapping
+import hashlib
+import math
+import numpy as np
+from scipy.optimize import linear_sum_assignment
+from cognitum.spatial_p2k_dense_identity import Detection, Params, validate_parameters
+from cognitum.spatial_p2l_appearance import (observation_id, _image, ENCODER_ID,
+    ENCODER_DIGEST, CONVERSATION, P2LRejected)
+from cognitum.spatial_appearance_evidence import assess, AppearanceRejected
+from cognitum.proto import spatial_appearance_pb2 as pb
+
+COLOR_ID = 'c15.r2.spatial-hsv8.v1'
+COLOR_DIGEST = hashlib.sha256(b'C15:R2:SPATIAL-HSV8:4X4:128D:V1').digest()
+MODEL_ID = 'c15.appearance-association.r2.research'
+
+class R2Rejected(ValueError):
+    pass
+
+
+@dataclass(frozen=True)
+class R2Config:
+    adaptive_appearance: bool = True
+    guarded_updates: bool = True
+    color_features: bool = True
+    kalman_motion: bool = True
+    long_gap_gallery: bool = True
+    ambiguous_abstention: bool = True
+    size_geometry: bool = True
+    max_reentry_gap: int = 48
+    gallery_limit: int = 6
+    match_margin: float = 0.35
+    feature_update_rate: float = 0.18
+    appearance_weight: float = 8.0
+    color_weight: float = 0.55
+    max_appearance_distance: float = 0.85
+    max_color_distance: float = 0.9
+    max_size_log_ratio: float = 1.35
+    kalman_process_sigma: float = 4.0
+    measurement_sigma: float = 10.0
+    mahalanobis_gate: float = 16.0
+    reentry_feature_threshold: float = 0.3
+
+
+def check_config(c:R2Config):
+    if not isinstance(c,R2Config): raise R2Rejected('INVALID_CONFIG')
+    bool_fields=('adaptive_appearance','guarded_updates','color_features','kalman_motion',
+        'long_gap_gallery','ambiguous_abstention','size_geometry')
+    if any(type(getattr(c,k)) is not bool for k in bool_fields):raise R2Rejected('INVALID_SWITCH')
+    if type(c.max_reentry_gap)!=int or not 13<=c.max_reentry_gap<=240 or type(c.gallery_limit)!=int or not 1<=c.gallery_limit<=16:
+        raise R2Rejected('INVALID_CAPACITY')
+    fields=('match_margin','feature_update_rate','appearance_weight','color_weight',
+        'max_appearance_distance','max_color_distance','max_size_log_ratio',
+        'kalman_process_sigma','measurement_sigma','mahalanobis_gate','reentry_feature_threshold')
+    if any(not math.isfinite(getattr(c,k)) for k in fields):raise R2Rejected('NONFINITE_CONFIG')
+    if not (0<=c.match_margin<=10 and 0<=c.feature_update_rate<=1 and
+            0<=c.appearance_weight<=100 and 0<=c.color_weight<=1 and
+            0<c.max_appearance_distance<=2 and 0<c.max_color_distance<=2 and
+            0.1<=c.max_size_log_ratio<=5 and 0.01<=c.kalman_process_sigma<=200 and
+            0.1<=c.measurement_sigma<=200 and 1<=c.mahalanobis_gate<=100 and
+            0<c.reentry_feature_threshold<=2):raise R2Rejected('INVALID_CONFIG_RANGE')
+
+
+def color_histogram_from_rgb(rgb, d:Detection)->tuple[float,...]:
+    """4x4 spatial HSV categories, 8 bins/tile. Handcrafted, non-ReID."""
+    if not isinstance(d,Detection) or not all(math.isfinite(x) for x in (d.x,d.y,d.w,d.h)) or d.w<=0 or d.h<=0:
+        raise R2Rejected('INVALID_BOX')
+    l=max(0,math.floor(d.x)); t=max(0,math.floor(d.y))
+    r=min(rgb.width,math.ceil(d.x+d.w)); b=min(rgb.height,math.ceil(d.y+d.h))
+    if r-l<4 or b-t<4:raise R2Rejected('INVALID_CROP')
+    a=np.asarray(rgb.crop((l,t,r,b)).convert('HSV'),dtype=np.uint8)
+    hue=(a[:,:,0].astype(np.uint16)*6//256).astype(np.uint8)
+    cat=np.where(a[:,:,1]<48, np.where(a[:,:,2]<128,6,7), hue)
+    out=np.zeros(128,dtype=np.float64)
+    h,w=cat.shape
+    for iy in range(4):
+        for ix in range(4):
+            tile=cat[iy*h//4:(iy+1)*h//4, ix*w//4:(ix+1)*w//4]
+            if not tile.size:raise R2Rejected('EMPTY_TILE')
+            out[8*(iy*4+ix):8*(iy*4+ix+1)]=np.bincount(tile.ravel(),minlength=8)/tile.size
+    out/=np.linalg.norm(out)
+    return tuple(map(float,out))
+
+
+def color_descriptors(frames:Mapping[int,list[Detection]], images:Mapping[int,bytes],
+                      *,sequence:str, conversation_id:str=CONVERSATION)->dict[tuple[int,int],pb.AppearanceDescriptor]:
+    from PIL import Image, ImageOps
+    import io
+    if set(images)!={f for f,ds in frames.items() if ds}:
+        raise R2Rejected('IMAGE_FRAME_SET_MISMATCH')
+    result={}
+    for frame in sorted(frames):
+        if not frames[frame]:continue
+        payload=images[frame]
+        _image(payload) # enforce existing P2L size/decodability guard
+        with Image.open(io.BytesIO(payload)) as raw:
+            rgb=ImageOps.exif_transpose(raw).convert('RGB')
+        digest=hashlib.sha256(payload).digest()
+        for index,d in enumerate(frames[frame]):
+            vec=color_histogram_from_rgb(rgb,d)
+            spec=pb.AppearanceDescriptor(schema_version=1,model_id=COLOR_ID,
+                image_source_id=sequence,detection_id=observation_id(sequence,d,index),
+                conversation_id=conversation_id,frame=frame,encoder_sha256=COLOR_DIGEST,
+                frame_sha256=digest,vector=vec,research_only=True,grants_authority=False)
+            assess(spec)
+            result[frame,index]=spec
+    return result
+
+
+def _unit(v):
+    x=np.asarray(v,dtype=np.float64)
+    norm=np.linalg.norm(x)
+    if not np.isfinite(norm) or norm<1e-12:raise R2Rejected('INVALID_VECTOR')
+    return x/norm
+
+
+def _cos(a,b):return float(max(0,min(2,1-np.dot(a,b))))
+
+
+@dataclass
+class _State:
+    tid:int
+    frame:int
+    x:np.ndarray
+    P:np.ndarray
+    w:float
+    h:float
+    gray:np.ndarray
+    color:np.ndarray|None
+    gallery:deque=field(default_factory=deque)
+    hits:int=1
+    uncertain:bool=False
+
+
+def _init_state(tid:int,frame:int,d:Detection,g,c,R2Config_inst):
+    cx,cy=d.center
+    return _State(tid,frame,np.array([cx,cy,0.,0.]),np.diag([225.,225.,900.,900.]),d.w,d.h,g,c,
+        deque(maxlen=R2Config_inst.gallery_limit))
+
+
+def _predict(s:_State,dt:int,c:R2Config):
+    F=np.eye(4);F[0,2]=F[1,3]=dt
+    noise=c.kalman_process_sigma**2
+    # Continuous white acceleration covariance over dt, with explicit process noise.
+    Q=noise*np.array([[dt**4/4,0,dt**3/2,0],[0,dt**4/4,0,dt**3/2],
+                      [dt**3/2,0,dt**2,0],[0,dt**3/2,0,dt**2]],dtype=float)
+    return F@s.x, F@s.P@F.T+Q
+
+
+def _correction(state, pred, P, cx,cy,c):
+    R=(c.measurement_sigma**2)*np.eye(2)
+    S=P[:2,:2]+R
+    K=P[:,:2]@np.linalg.inv(S)
+    z=np.array([cx,cy])-pred[:2]
+    state.x=pred+K@z
+    # Joseph stabilized update, symmetric nonnegative covariance.
+    eye=np.eye(4);H=np.zeros((2,4));H[:,:2]=np.eye(2)
+    KH=K@H
+    state.P=(eye-KH)@P@(eye-KH).T+K@R@K.T
+    state.P=(state.P+state.P.T)*0.5
+
+
+def _iou_center(w1,h1,w2,h2,dx,dy):
+    iw=max(0,min(w1,w2,(w1+w2)/2-abs(dx)))
+    ih=max(0,min(h1,h2,(h1+h2)/2-abs(dy)))
+    inter=iw*ih
+    return inter/max(1e-10,w1*h1+w2*h2-inter)
+
+
+def associate_r2(frames:Mapping[int,list[Detection]], *, num_frames:int, sequence:str,
+                 image_bytes:Mapping[int,bytes], gray_descriptors:Mapping[tuple[int,int],pb.AppearanceDescriptor],
+                 color_descriptors_map:Mapping[tuple[int,int],pb.AppearanceDescriptor]|None=None,
+                 params:Params=Params(), config:R2Config=R2Config()):
+    """ID-blind R2 hypothesis assignments; ambiguity may spawn a tentative track ID.
+
+    Gray and color sources must be bound to identical actual image bytes/boxes.
+    Ground truth and source tracker identity are never accepted as inputs.
+    """
+    validate_parameters(params);check_config(config)
+    if type(num_frames)!=int or not 1<=num_frames<=100000 or not sequence or len(sequence)>128:
+        raise R2Rejected('INVALID_INPUT')
+    if any(type(f)!=int or not 1<=f<=num_frames for f in frames):raise R2Rejected('INVALID_FRAME')
+    keys={(f,i) for f,ds in frames.items() for i in range(len(ds))}
+    if not keys or len(keys)>500000 or set(gray_descriptors)!=keys or set(image_bytes)!={f for f,ds in frames.items() if ds}:
+        raise R2Rejected('INCOMPLETE_INPUT')
+    if config.color_features and (color_descriptors_map is None or set(color_descriptors_map)!=keys):
+        raise R2Rejected('COLOR_EVIDENCE_MISSING')
+    if color_descriptors_map is not None and set(color_descriptors_map)!=keys:raise R2Rejected('EXTRA_COLOR_EVIDENCE')
+    vetted={}
+    for f,ds in frames.items():
+        if len(ds)>params.max_boxes:raise R2Rejected('DENSITY_EXCEEDS_CAPACITY')
+        if not ds:continue
+        payload=image_bytes[f];_image(payload);digest=hashlib.sha256(payload).digest()
+        for i,d in enumerate(ds):
+            if not isinstance(d,Detection) or d.frame!=f or d.w<=0 or d.h<=0 or not all(math.isfinite(v) for v in (d.x,d.y,d.w,d.h)):
+                raise R2Rejected('INVALID_DETECTION')
+            binding=observation_id(sequence,d,i)
+            specs=[(gray_descriptors[(f,i)],ENCODER_ID,ENCODER_DIGEST)]
+            if config.color_features:specs.append((color_descriptors_map[(f,i)],COLOR_ID,COLOR_DIGEST))
+            vecs=[]
+            for spec,model,enc in specs:
+                try:assess(spec)
+                except AppearanceRejected as exc:raise R2Rejected('INVALID_APPEARANCE') from exc
+                if (spec.frame!=f or spec.image_source_id!=sequence or spec.detection_id!=binding or
+                    spec.conversation_id!=CONVERSATION or spec.frame_sha256!=digest or
+                    spec.model_id!=model or spec.encoder_sha256!=enc):raise R2Rejected('PROVENANCE_MISMATCH')
+                vecs.append(_unit(spec.vector))
+            vetted[f,i]=(vecs[0],vecs[1] if len(vecs)>1 else None)
+    states:dict[int,_State]={};labels={};nextid=1;counts=Counter();audit=[]
+    for frame in range(1,num_frames+1):
+        # Unresolved tentative IDs are ephemeral. Only established tracks may
+        # enter the extended gallery; this prevents identity-abstention storms.
+        def ttl_for(s):
+            if s.uncertain:return 2
+            if config.long_gap_gallery and s.hits>=3:return config.max_reentry_gap
+            return params.max_gap_frames
+        states={tid:s for tid,s in states.items() if frame-s.frame<=ttl_for(s)}
+        if len(states)>params.max_tracks:raise R2Rejected('ACTIVE_TRACK_LIMIT')
+        ds=frames.get(frame,[])
+        if not ds:continue
+        active=sorted(states.values(),key=lambda x:x.tid)
+        n=len(ds);t=len(active)
+        predicted={s.tid:_predict(s,frame-s.frame,config) for s in active}
+        distinctiveness={}
+        if config.adaptive_appearance:
+            for s in active:
+                others=[_cos(s.gray,o.gray) for o in active if o.tid!=s.tid]
+                distinctiveness[s.tid]=max(0.15,min(1.,min(others)/0.35)) if others else 1.
+        scores=np.full((n,t+n),1e10,dtype=float)
+        scores[:,t:]=params.unmatched_cost+np.arange(n)[None,:]*1e-10
+        appdist=np.full((n,t),float('inf'))
+        for i,d in enumerate(ds):
+            gray,color=vetted[frame,i];cx,cy=d.center
+            for j,s in enumerate(active):
+                dt=frame-s.frame
+                pred,P=predicted[s.tid]
+                dx=cx-pred[0] if config.kalman_motion else cx-s.x[0]
+                dy=cy-pred[1] if config.kalman_motion else cy-s.x[1]
+                motion=0.5*((dx*dx+dy*dy)/(params.sigma_px**2))
+                if config.kalman_motion:
+                    # The configured CV model has diagonal XY innovation
+                    # covariance; avoid allocating a matrix for every pair.
+                    norm2=float(dx*dx/(P[0,0]+config.measurement_sigma**2)+
+                                dy*dy/(P[1,1]+config.measurement_sigma**2))
+                    motion=0.5*norm2
+                    if norm2>config.mahalanobis_gate:continue
+                elif math.hypot(dx,dy)>params.max_speed_px_per_frame*dt+3*params.sigma_px:continue
+                if config.size_geometry:
+                    size_dist=abs(math.log(d.w/s.w))+abs(math.log(d.h/s.h))
+                    if size_dist>2*config.max_size_log_ratio:continue
+                    ratio_cost=0.3*size_dist
+                    iou=_iou_center(s.w,s.h,d.w,d.h,dx,dy)
+                    geometry_cost=0.35*(1-iou)
+                else:ratio_cost=geometry_cost=0
+                dg=_cos(gray,s.gray)
+                if config.long_gap_gallery and s.gallery:
+                    dg=min([dg]+[_cos(gray,oldg) for oldg,_ in s.gallery])
+                dc=_cos(color,s.color) if color is not None and s.color is not None else 0
+                if config.long_gap_gallery and color is not None and s.gallery:
+                    dc=min([dc]+[_cos(color,oldc) for _,oldc in s.gallery if oldc is not None])
+                if dg>config.max_appearance_distance or (color is not None and dc>config.max_color_distance):continue
+                appearance=(1-config.color_weight)*dg+config.color_weight*dc if color is not None else dg
+                appdist[i,j]=appearance
+                if dt>params.max_gap_frames and (not config.long_gap_gallery or appearance>config.reentry_feature_threshold):continue
+                distinct=1.0
+                if config.adaptive_appearance:
+                    # If enrolled tracks are visually indistinguishable,
+                    # down-weight appearance rather than repeating O(tracks^2)
+                    # comparisons for every detection.
+                    distinct=distinctiveness[s.tid]
+                    if dt>params.max_gap_frames:distinct=max(distinct,0.9)
+                w=config.appearance_weight*distinct
+                score=motion+ratio_cost+geometry_cost+w*appearance
+                if math.isfinite(score) and score<=params.unmatched_cost:
+                    scores[i,j]=score+1e-9*j
+        row,col=linear_sum_assignment(scores)
+        if len(row)!=n:raise R2Rejected('ASSIGNMENT_INCOMPLETE')
+        result=[None]*n
+        for i,j in zip(row.tolist(),col.tolist()):
+            d=ds[i];cx,cy=d.center;gray,color=vetted[frame,i]
+            is_match=(j<t and scores[i,j]<1e9)
+            ambiguous=False
+            candidates=[]
+            if is_match:
+                # Both sides: nearest competing track and next-best detection
+                # for this track, plus explicit unmatched option.
+                alternative=min(float(np.min(np.delete(scores[i,:t],j))) if t>1 else 1e10,
+                                float(np.min(np.delete(scores[:,j],i))) if n>1 else 1e10,
+                                params.unmatched_cost)
+                margin=alternative-scores[i,j]
+                ambiguous=margin<=config.match_margin
+                candidates=[active[k].tid for k in np.argsort(scores[i,:t])[:min(t,3)] if scores[i,k]<1e9]
+                if ambiguous:counts['ambiguous_matches']+=1
+                if config.ambiguous_abstention and ambiguous:
+                    is_match=False;counts['abstained_identity_proposals']+=1
+            if is_match:
+                s=active[j];dt=frame-s.frame
+                pred,P=predicted[s.tid]
+                if config.kalman_motion:_correction(s,pred,P,cx,cy,config)
+                else:
+                    vx=(cx-s.x[0])/dt;vy=(cy-s.x[1])/dt
+                    s.x=np.array([cx,cy,vx,vy]);s.P=np.diag([params.sigma_px**2]*4)
+                s.frame=frame;s.w=d.w;s.h=d.h;s.hits+=1;s.uncertain=False
+                # Never update a questionable template; maintain bounded
+                # gallery with old reliable observations for re-entry.
+                if not (config.guarded_updates and ambiguous):
+                    rate=config.feature_update_rate if config.guarded_updates else 0.4
+                    if config.long_gap_gallery:
+                        s.gallery.append((s.gray.copy(),s.color.copy() if s.color is not None else None))
+                    s.gray=_unit((1-rate)*s.gray+rate*gray)
+                    if color is not None and s.color is not None:s.color=_unit((1-rate)*s.color+rate*color)
+                    counts['template_updates']+=1
+                else:counts['template_updates_blocked']+=1
+                if dt>params.max_gap_frames:counts['gallery_reentries']+=1
+                counts['matched_boxes']+=1;result[i]=s.tid
+                if ambiguous:counts['forced_ambiguous_research_matches']+=1
+            else:
+                if nextid>1000000:raise R2Rejected('TRACK_ID_CAPACITY')
+                tid=nextid;nextid+=1
+                states[tid]=_init_state(tid,frame,d,gray,color,config)
+                states[tid].uncertain=ambiguous
+                result[i]=tid;counts['new_identity_proposals']+=1
+            if ambiguous:
+                audit.append({'frame':frame,'detection_index':i,'candidate_ids':candidates,
+                              'decision':'tentative_new_id' if not is_match else 'forced_hypothesis',
+                              'not_authorized':True})
+        if len(set(result))!=n:raise R2Rejected('DUPLICATE_FRAME_IDS')
+        labels[frame]=result
+        counts['input_boxes']+=n;counts['observed_frames']+=1
+        counts['max_frame_boxes']=max(counts['max_frame_boxes'],n)
+        counts['max_active_tracks']=max(counts['max_active_tracks'],len(states))
+    counts['frames_without_detections']=num_frames-counts['observed_frames']
+    counts['research_only_no_authority']=1
+    counts['unattested_image_observations']=len(keys)
+    return labels,dict(counts),audit
+
+
+def to_protobuf_report(*, labels:dict, stats:dict, audit:list, sequence:str,
+                       config:R2Config, conversation_id:str=CONVERSATION):
+    """Emit a versioned, read-only Protobuf hypothesis artifact for C15 consumers."""
+    from dataclasses import asdict
+    import json
+    from cognitum.proto import spatial_appearance_r2_pb2 as msg
+    check_config(config)
+    if not sequence or not conversation_id or not labels:
+        raise R2Rejected('INVALID_REPORT_INPUT')
+    digest=hashlib.sha256(json.dumps(asdict(config),sort_keys=True,allow_nan=False).encode()).digest()
+    result=msg.R2ResearchReport(schema_version=1,conversation_id=conversation_id,
+            sequence_id=sequence,model_id=MODEL_ID,configuration_sha256=digest,
+            research_only=True,grants_authority=False,
+            abstained_identity_proposals=stats.get('abstained_identity_proposals',0),
+            template_updates_blocked=stats.get('template_updates_blocked',0),
+            gallery_reentries=stats.get('gallery_reentries',0))
+    by_key={(a['frame'],a['detection_index']):a for a in audit}
+    for frame in sorted(labels):
+        if type(frame) is not int or frame<1:raise R2Rejected('INVALID_REPORT_FRAME')
+        ids=labels[frame]
+        if len(ids)!=len(set(ids)):raise R2Rejected('DUPLICATE_FRAME_IDS')
+        for i,ident in enumerate(ids):
+            if type(ident) is not int or ident<1:raise R2Rejected('INVALID_REPORT_ID')
+            a=by_key.get((frame,i))
+            result.hypotheses.add(frame=frame,observation_ordinal=i,
+                proposed_track_id=ident,alternative_track_ids=a['candidate_ids'] if a else [],
+                ambiguous=bool(a),tentative=bool(a and a['decision']=='tentative_new_id'))
+    return result
