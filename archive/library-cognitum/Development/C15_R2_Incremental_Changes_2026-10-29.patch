+"""Matched MOT17 real-image R2 ablation (original IDs hidden from both candidates)."""
+from __future__ import annotations
+import argparse,configparser,hashlib,json,shutil,subprocess,sys,time
+from dataclasses import asdict,replace
+from pathlib import Path
+from cognitum import spatial_p2l_appearance as old
+from cognitum import spatial_appearance_r2 as r2
+from cognitum import spatial_p2k_dense_identity as dense
+from cognitum import spatial_p2k_challenge_gate as challenge
+from cognitum import spatial_mot17_realdata_gate as rd
+from cognitum.spatial_trackeval_bridge import read_summary
+
+ARMS=('MPNTrackOriginal','CognitumRealAppearanceVelocity','CognitumR2All','CognitumR2NoColor')
+
+def sha(p:Path):
+    h=hashlib.sha256()
+    with p.open('rb') as f:
+        for x in iter(lambda:f.read(1024*1024),b''):h.update(x)
+    return h.hexdigest()
+
+def copy_input(src:Path,dst:Path):
+    if dst.exists():raise RuntimeError('STAGE_NONEMPTY')
+    dst.mkdir(parents=True)
+    for seq in challenge.SEQUENCES:
+        for name in (f'gt/MOT17-train/{seq}/gt/gt.txt',f'gt/MOT17-train/{seq}/seqinfo.ini'):
+            target=dst/name;target.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(src/name,target)
+        for arm in ARMS[:2]:
+            name=f'trackers/MOT17-train/{arm}/data/{seq}.txt'
+            target=dst/name;target.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(src/name,target)
+    (dst/'gt/seqmaps').mkdir(parents=True)
+    shutil.copyfile(src/'gt/seqmaps/MOT17-train.txt',dst/'gt/seqmaps/MOT17-train.txt')
+
+
+def run(*,baseline:Path,train:Path,out:Path,source:Path,source_zip:Path):
+    copy_input(baseline,out)
+    evidence={'milestone':'C15_APPEARANCE_ASSOCIATION_R2','version':'R2.v1','research_only':True,
+       'source_tracker_ids_passed_to_r2':False,'ground_truth_passed_to_r2':False,
+       'matched_boxes':True,'sequences':{},'model':r2.MODEL_ID,
+       'variants':{'CognitumR2All':asdict(r2.R2Config()),
+                   'CognitumR2NoColor':asdict(replace(r2.R2Config(),color_features=False))},
+       'frames_sha256':{},'inputs_sha256':{},'outputs_sha256':{}}
+    for seq in challenge.SEQUENCES:
+        begin=time.monotonic()
+        src=out/f'trackers/MOT17-train/MPNTrackOriginal/data/{seq}.txt'
+        cfg=configparser.ConfigParser();cfg.read(train/seq/'seqinfo.ini')
+        nframes=int(cfg['Sequence']['seqLength'])
+        frames,source_rows=dense.parse_id_blind(src.read_bytes(),num_frames=nframes)
+        images={f:(train/seq/'img1'/f'{f:06d}.jpg').read_bytes() for f in sorted(frames)}
+        evidence['frames_sha256'][seq]={f:hashlib.sha256(v).hexdigest() for f,v in images.items()}
+        t=time.monotonic()
+        gray=old.descriptors_from_frames(frames,images,sequence=seq)
+        color=r2.color_descriptors(frames,images,sequence=seq)
+        feature_time=round(time.monotonic()-t,3)
+        evidence['sequences'][seq]={'feature_seconds':feature_time,'boxes':len(gray), 'frame_count':nframes,'variants':{}}
+        for arm in ARMS[2:]:
+            config=r2.R2Config() if arm==ARMS[2] else replace(r2.R2Config(),color_features=False)
+            print('RUN',seq,arm,'boxes',len(gray),flush=True)
+            t=time.monotonic()
+            labels,stats,audit=r2.associate_r2(frames,num_frames=nframes,sequence=seq,
+               image_bytes=images,gray_descriptors=gray,
+               color_descriptors_map=color if config.color_features else None,config=config)
+            elapsed=round(time.monotonic()-t,3)
+            rows=[]
+            for f in range(1,nframes+1):
+                before=source_rows.get(f,[]);assigned=labels.get(f,[])
+                if len(before)!=len(assigned):raise RuntimeError('INPUT_BOX_DROPPED')
+                for a,ident in zip(before,assigned):
+                    b=a.copy();b[1]=str(ident)
+                    if a[0]!=b[0] or a[2:]!=b[2:]:raise RuntimeError('SOURCE_FIELDS_CHANGED')
+                    rows.append(','.join(b))
+            dest=out/f'trackers/MOT17-train/{arm}/data/{seq}.txt'
+            dest.parent.mkdir(parents=True,exist_ok=True)
+            dest.write_text('\n'.join(rows)+'\n')
+            original=src.read_text().splitlines();changed=dest.read_text().splitlines()
+            if len(changed)!=len(original) or any(a.split(',')[0]!=b.split(',')[0] or a.split(',')[2:]!=b.split(',')[2:]
+                  for a,b in zip(original,changed)):raise RuntimeError('BOX_PROVENANCE_MISMATCH')
+            evidence['sequences'][seq]['variants'][arm]={'counts':stats,'audit_sample':audit[:120],
+                'audit_count':len(audit),'association_seconds':elapsed,'output_sha256':sha(dest)}
+            print('DONE',seq,arm,'time',elapsed,'abstain',stats.get('abstained_identity_proposals',0),flush=True)
+        evidence['sequences'][seq]['total_seconds']=round(time.monotonic()-begin,3)
+    evidence['inputs_sha256']={str(p.relative_to(out)):sha(p) for p in sorted((out/'gt').rglob('*')) if p.is_file()}
+    evidence['outputs_sha256']={str(p.relative_to(out)):sha(p) for p in sorted((out/'trackers').rglob('*.txt'))}
+    pin=rd.verify_pinned_trackeval_source(source_zip=source_zip,checkout=source)
+    shim=Path(__file__).parent/'c15_trackeval_legacy_numpy_compat.py'
+    command=[sys.executable,str(shim),str(source/'scripts/run_mot_challenge.py'),
+      '--GT_FOLDER',str(out/'gt'),'--TRACKERS_FOLDER',str(out/'trackers'),
+      '--BENCHMARK','MOT17','--SPLIT_TO_EVAL','train','--TRACKERS_TO_EVAL',*ARMS,
+      '--CLASSES_TO_EVAL','pedestrian','--METRICS','HOTA','CLEAR','Identity',
+      '--DO_PREPROC','True','--PLOT_CURVES','False','--PRINT_CONFIG','False',
+      '--TIME_PROGRESS','False','--USE_PARALLEL','False']
+    print('OFFICIAL_TRACK_EVAL',flush=True)
+    proc=subprocess.run(command,cwd=source,text=True,capture_output=True,timeout=600)
+    if proc.returncode:raise RuntimeError('OFFICIAL_FAILED:'+proc.stdout[-4000:]+proc.stderr[-2000:])
+    if rd.verify_pinned_trackeval_source(source_zip=source_zip,checkout=source)!=pin:raise RuntimeError('EVALUATOR_CHANGED')
+    for name,h in evidence['inputs_sha256'].items():
+        if sha(out/name)!=h:raise RuntimeError('GT_CHANGED')
+    for name,h in evidence['outputs_sha256'].items():
+        if sha(out/name)!=h:raise RuntimeError('PREDICTION_CHANGED')
+    evidence['evaluator_pin']=pin
+    evidence['metrics']={arm:read_summary(out/'trackers/MOT17-train'/arm/'pedestrian_summary.txt') for arm in ARMS}
+    evidence['metric_sha256']={arm:sha(out/'trackers/MOT17-train'/arm/'pedestrian_summary.txt') for arm in ARMS}
+    evidence['stdout_tail']=proc.stdout[-1800:]
+    for name in ARMS:
+        val=evidence['metrics'][name]
+        print('METRIC',name,{key:val[key] for key in ('HOTA','AssA','MOTA','IDF1','IDSW')},flush=True)
+    (out/'r2_evidence.json').write_text(json.dumps(evidence,indent=2,sort_keys=True)+'\n')
+    return evidence
+
+if __name__=='__main__':
+    p=argparse.ArgumentParser()
+    for k in ('baseline','train','out','source','source-zip'):p.add_argument('--'+k,required=True,type=Path)
+    a=p.parse_args();run(baseline=a.baseline,train=a.train,out=a.out,source=a.source,source_zip=a.source_zip)
